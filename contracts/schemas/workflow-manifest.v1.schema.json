{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yanchuaner.cn/ecosystem/v1/workflow-manifest.v1.schema.json",
  "title": "Yanzhong Workflow Manifest v1",
  "type": "object",
  "required": ["schema_version", "workflow_id", "version", "status", "entry_schema", "output_schema", "blocks", "limits"],
  "properties": {
    "schema_version": {
      "$ref": "common-defs.v1.schema.json#/$defs/schemaVersion"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 96
    },
    "version": {
      "$ref": "common-defs.v1.schema.json#/$defs/semanticVersion"
    },
    "status": { "enum": ["draft", "preview", "stable", "deprecated", "disabled"] },
    "entry_schema": {
      "$ref": "common-defs.v1.schema.json#/$defs/uriReference"
    },
    "output_schema": {
      "$ref": "common-defs.v1.schema.json#/$defs/uriReference"
    },
    "required_scopes": {
      "type": "array",
      "items": { "$ref": "common-defs.v1.schema.json#/$defs/stableCode" },
      "uniqueItems": true,
      "maxItems": 64
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+)+$",
        "maxLength": 96
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["id", "version", "input_schema", "output_schema", "side_effects", "billing", "timeout_ms", "retry", "idempotency"],
        "properties": {
          "id": { "$ref": "common-defs.v1.schema.json#/$defs/stableCode" },
          "version": { "$ref": "common-defs.v1.schema.json#/$defs/semanticVersion" },
          "input_schema": { "$ref": "common-defs.v1.schema.json#/$defs/uriReference" },
          "output_schema": { "$ref": "common-defs.v1.schema.json#/$defs/uriReference" },
          "required_scopes": {
            "type": "array",
            "items": { "$ref": "common-defs.v1.schema.json#/$defs/stableCode" },
            "uniqueItems": true
          },
          "side_effects": {
            "type": "array",
            "items": { "enum": ["data_write", "data_delete", "network", "external_send", "paid_call"] },
            "uniqueItems": true
          },
          "billing": { "enum": ["none", "platform", "byok"] },
          "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
          "retry": { "enum": ["never", "safe", "idempotency_key"] },
          "idempotency": {
            "type": "object",
            "required": ["mode"],
            "properties": {
              "mode": { "enum": ["none", "derived", "required"] },
              "key_field": { "type": "string", "minLength": 1, "maxLength": 128 }
            },
            "allOf": [
              {
                "if": { "properties": { "mode": { "const": "required" } }, "required": ["mode"] },
                "then": { "required": ["key_field"] }
              }
            ],
            "additionalProperties": false
          },
          "compensation": { "type": "string", "maxLength": 512 }
        },
        "allOf": [
          {
            "if": { "properties": { "billing": { "const": "platform" } }, "required": ["billing"] },
            "then": { "properties": { "side_effects": { "contains": { "const": "paid_call" } } } }
          },
          {
            "if": { "properties": { "side_effects": { "contains": { "const": "paid_call" } } }, "required": ["side_effects"] },
            "then": { "properties": { "billing": { "enum": ["platform", "byok"] } } }
          },
          {
            "if": { "properties": { "retry": { "const": "idempotency_key" } }, "required": ["retry"] },
            "then": { "properties": { "idempotency": { "properties": { "mode": { "const": "required" } } } } }
          },
          {
            "if": { "properties": { "side_effects": { "minItems": 1 } }, "required": ["side_effects"] },
            "then": { "properties": { "idempotency": { "properties": { "mode": { "enum": ["derived", "required"] } } } } }
          }
        ],
        "additionalProperties": true
      }
    },
    "limits": {
      "type": "object",
      "required": ["timeout_ms", "max_paid_calls"],
      "properties": {
        "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "max_paid_calls": { "type": "integer", "minimum": 0, "maximum": 128 },
        "max_parallel_steps": { "type": "integer", "minimum": 1, "maximum": 64 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "schema_version": "1.0",
      "workflow_id": "group-chat",
      "version": "1.0.0",
      "status": "preview",
      "entry_schema": "message-envelope.v1.schema.json",
      "output_schema": "message-envelope.v1.schema.json",
      "required_scopes": ["ai.chat"],
      "required_capabilities": ["text.chat.general"],
      "blocks": [
        {
          "id": "conversation.reply",
          "version": "1.0.0",
          "input_schema": "schema:conversation-context-v1",
          "output_schema": "message-envelope.v1.schema.json",
          "required_scopes": ["ai.chat"],
          "side_effects": ["paid_call", "data_write"],
          "billing": "platform",
          "timeout_ms": 120000,
          "retry": "idempotency_key",
          "idempotency": { "mode": "required", "key_field": "client_request_id" },
          "compensation": "Use the gateway request status before retrying."
        }
      ],
      "limits": { "timeout_ms": 180000, "max_paid_calls": 4, "max_parallel_steps": 2 }
    }
  ]
}
