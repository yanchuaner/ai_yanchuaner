{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yanchuaner.cn/ecosystem/v1/telemetry-event.v1.schema.json",
  "title": "Yanzhong Telemetry Event v1",
  "type": "object",
  "required": ["schema_version", "event_id", "timestamp", "service", "component", "environment", "version", "event", "outcome", "attributes"],
  "properties": {
    "schema_version": { "$ref": "common-defs.v1.schema.json#/$defs/schemaVersion" },
    "event_id": { "$ref": "common-defs.v1.schema.json#/$defs/opaqueId" },
    "timestamp": { "$ref": "common-defs.v1.schema.json#/$defs/timestamp" },
    "service": { "$ref": "common-defs.v1.schema.json#/$defs/stableCode" },
    "component": { "$ref": "common-defs.v1.schema.json#/$defs/stableCode" },
    "environment": { "enum": ["development", "integration", "staging", "preview", "production"] },
    "version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "event": { "$ref": "common-defs.v1.schema.json#/$defs/stableCode" },
    "outcome": { "enum": ["success", "failure", "cancelled", "denied", "degraded", "unknown"] },
    "trace_id": { "$ref": "common-defs.v1.schema.json#/$defs/opaqueId" },
    "client_request_id": { "$ref": "common-defs.v1.schema.json#/$defs/opaqueId" },
    "workflow_run_id": { "$ref": "common-defs.v1.schema.json#/$defs/opaqueId" },
    "step_id": { "$ref": "common-defs.v1.schema.json#/$defs/opaqueId" },
    "request_id": { "$ref": "common-defs.v1.schema.json#/$defs/opaqueId" },
    "attempt_id": { "$ref": "common-defs.v1.schema.json#/$defs/opaqueId" },
    "duration_ms": { "$ref": "common-defs.v1.schema.json#/$defs/nonNegativeInteger" },
    "subject_hash": { "type": "string", "pattern": "^[a-f0-9]{32,128}$" },
    "error_code": { "$ref": "common-defs.v1.schema.json#/$defs/stableCode" },
    "attributes": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean", "null"]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "enum": ["failure", "denied"] } },
        "required": ["outcome"]
      },
      "then": { "required": ["error_code"] }
    }
  ],
  "additionalProperties": true,
  "examples": [
    {
      "schema_version": "1.0",
      "event_id": "evt_01J00000000000000000000000",
      "timestamp": "2026-08-13T12:00:00Z",
      "service": "ai-web",
      "component": "workflow.runtime",
      "environment": "preview",
      "version": "20260813-a1b2c3d",
      "event": "workflow.step.completed",
      "outcome": "success",
      "trace_id": "tr_01J00000000000000000000000",
      "request_id": "req_01J00000000000000000000000",
      "duration_ms": 842,
      "attributes": {}
    }
  ]
}
